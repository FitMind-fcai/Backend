---
title: FitMind Design Class Diagram (Features, Entities, Repositories)
---
classDiagram
    %% ========== AUTHENTICATION MODULE ==========
    
    namespace AuthModule {
        class User {
            <<Entity>>
            +int id
            +string name
            +string email
            +int age
            +string password
            +boolean is_verified
            +datetime created_at
            +datetime updated_at
        }

        class UserRepository {
            <<Repository>>
            -Session db
            +create_user(name, email, age, hashed_password) User
            +get_by_id(user_id) User
            +get_by_email(email) User
            +email_exists(email) bool
            +mark_as_verified(user) User
            +update_password(user, hashed_password) User
        }

        class AuthService {
            <<Service>>
            -UserRepository user_repo
            -VerificationService verification_service
            -AuthEmailService email_service
            +create_user(user_data) tuple[User, str]
            +authenticate_user(credentials) tuple[User, str]
            +verify_user_email(token) User
            +resend_verification(email) str
            +reset_user_password(user, new_password) void
            +get_user_by_email(email, require_verified) User
        }

        class VerificationService {
            <<Service>>
            -Redis redis_client
            +create_verification_token(email) str
            +validate_verification_token(token) str
            +delete_verification_token(token) void
        }

        class OTPService {
            <<Service>>
            -Redis redis_client
            +create_password_reset_otp(email) str
            +validate_otp(email, otp) bool
            +clear_otp(email) void
            +is_otp_valid(email) bool
            +get_otp_ttl(email) int
        }

        class AuthEmailService {
            <<Service>>
            -EmailService base_email_service
            +send_verification_email(email, token) bool
            +send_resend_verification_email(email, token) bool
            +send_password_reset_otp(email, otp) bool
        }

        class SecurityUtils {
            <<Utility>>
            +hash_password(password) str
            +verify_password(plain_password, hashed_password) bool
            +create_access_token(user_id, email) str
            +verify_access_token(token) dict
            +generate_otp() str
            +hash_otp(otp) str
            +verify_otp(plain_otp, hashed_otp) bool
            +generate_verification_token() str
        }
    }

    %% ========== PROFILE MODULE ==========
    
    namespace ProfileModule {
        class Profile {
            <<Entity>>
            +int id
            +int user_id
            +int age
            +Gender gender
            +float height
            +float weight
            +FitnessGoal fitness_goal
            +ActivityLevel activity_level
            +string dietary_preference
            +string medical_conditions
            +string allergies
            +string injuries
            +string medications
            +datetime updated_at
        }

        class ProfileRepository {
            <<Repository>>
            -Session db
            +create_profile(user_id, profile_data) Profile
            +get_by_user_id(user_id) Profile
            +update_profile(user_id, profile_data) Profile
            +delete_profile(user_id) bool
            +profile_exists(user_id) bool
        }

        class ProfileService {
            <<Service>>
            -ProfileRepository profile_repo
            +create_profile(user_id, profile_data) Profile
            +get_profile_by_user_id(user_id) Profile
            +update_profile(user_id, profile_data) Profile
            +delete_profile(user_id) bool
        }

        class Gender {
            <<Enumeration>>
            MALE
            FEMALE
        }

        class ActivityLevel {
            <<Enumeration>>
            SEDENTARY
            LIGHTLY_ACTIVE
            MODERATELY_ACTIVE
            VERY_ACTIVE
            EXTRA_ACTIVE
        }

        class FitnessGoal {
            <<Enumeration>>
            LOSE_WEIGHT
            MAINTAIN_WEIGHT
            BUILD_MUSCLE
        }
    }

    %% ========== PLANNING MODULE ==========
    
    namespace PlanningModule {
        class WorkoutPlan {
            <<Entity>>
            +int id
            +int user_id
            +string plan_name
            +string description
            +date start_date
            +date end_date
            +string frequency
            +string difficulty_level
            +datetime created_at
        }

        class WorkoutDay {
            <<Entity>>
            +int id
            +int workout_plan_id
            +string day_name
            +int day_number
            +string focus_area
            +int estimated_duration
        }

        class Exercise {
            <<Entity>>
            +int id
            +int workout_day_id
            +string exercise_name
            +string exercise_type
            +int sets
            +int reps
            +float weight
            +int duration_seconds
            +string instructions
            +string video_url
        }

        class NutritionPlan {
            <<Entity>>
            +int id
            +int user_id
            +string plan_name
            +int daily_calories
            +int daily_protein
            +int daily_carbs
            +int daily_fats
            +date start_date
            +date end_date
            +datetime created_at
        }

        class Meal {
            <<Entity>>
            +int id
            +int nutrition_plan_id
            +string meal_type
            +string meal_name
            +int calories
            +int protein
            +int carbs
            +int fats
            +string ingredients
            +string instructions
        }

        class WorkoutPlanRepository {
            <<Repository>>
            -Session db
            +create_plan(user_id, plan_data) WorkoutPlan
            +get_by_user_id(user_id) WorkoutPlan
            +get_by_id(plan_id) WorkoutPlan
            +update_plan(plan_id, plan_data) WorkoutPlan
            +delete_plan(plan_id) bool
        }

        class NutritionPlanRepository {
            <<Repository>>
            -Session db
            +create_plan(user_id, plan_data) NutritionPlan
            +get_by_user_id(user_id) NutritionPlan
            +get_by_id(plan_id) NutritionPlan
            +update_plan(plan_id, plan_data) NutritionPlan
            +delete_plan(plan_id) bool
        }

        class PlanningService {
            <<Service>>
            -WorkoutPlanRepository workout_repo
            -NutritionPlanRepository nutrition_repo
            -AICoachService ai_coach
            -ProfileService profile_service
            +request_workout_plan(user_id, plan_preferences) WorkoutPlan
            +request_nutrition_plan(user_id, plan_preferences) NutritionPlan
            +get_current_workout_plan(user_id) WorkoutPlan
            +get_current_nutrition_plan(user_id) NutritionPlan
            +adapt_plan_based_on_progress(user_id) void
        }
    }

    %% ========== TRACKING MODULE ==========
    
    namespace TrackingModule {
        class WorkoutLog {
            <<Entity>>
            +int id
            +int user_id
            +int exercise_id
            +date log_date
            +int sets_completed
            +int reps_completed
            +float weight_used
            +int duration_seconds
            +string notes
            +datetime created_at
        }

        class MealLog {
            <<Entity>>
            +int id
            +int user_id
            +date log_date
            +string meal_type
            +string meal_name
            +int calories
            +int protein
            +int carbs
            +int fats
            +LogMethod log_method
            +string image_url
            +datetime created_at
        }

        class WeightLog {
            <<Entity>>
            +int id
            +int user_id
            +date log_date
            +float weight
            +string notes
            +datetime created_at
        }

        class WorkoutLogRepository {
            <<Repository>>
            -Session db
            +create_log(user_id, log_data) WorkoutLog
            +get_by_user_id(user_id, start_date, end_date) list[WorkoutLog]
            +get_by_date_range(user_id, start, end) list[WorkoutLog]
            +delete_log(log_id) bool
        }

        class MealLogRepository {
            <<Repository>>
            -Session db
            +create_log(user_id, log_data) MealLog
            +get_by_user_id(user_id, start_date, end_date) list[MealLog]
            +get_daily_nutrition(user_id, date) dict
            +delete_log(log_id) bool
        }

        class WeightLogRepository {
            <<Repository>>
            -Session db
            +create_log(user_id, log_data) WeightLog
            +get_by_user_id(user_id) list[WeightLog]
            +get_latest_weight(user_id) WeightLog
            +get_weight_trend(user_id, days) list[WeightLog]
            +delete_log(log_id) bool
        }

        class TrackingService {
            <<Service>>
            -WorkoutLogRepository workout_log_repo
            -MealLogRepository meal_log_repo
            -WeightLogRepository weight_log_repo
            +log_workout(user_id, workout_data) WorkoutLog
            +log_meal_text(user_id, meal_data) MealLog
            +log_meal_voice(user_id, audio_file) MealLog
            +log_meal_camera(user_id, image_file) MealLog
            +log_weight(user_id, weight_data) WeightLog
            +get_progress_summary(user_id) dict
            +get_workout_history(user_id, days) list[WorkoutLog]
            +get_nutrition_history(user_id, days) list[MealLog]
            +get_weight_history(user_id, days) list[WeightLog]
        }

        class LogMethod {
            <<Enumeration>>
            TEXT
            VOICE
            CAMERA
        }
    }

    %% ========== CHATBOT MODULE ==========
    
    namespace ChatbotModule {
        class ChatMessage {
            <<Entity>>
            +int id
            +int user_id
            +string message_content
            +string response_content
            +MessageRole role
            +datetime created_at
        }

        class ChatMessageRepository {
            <<Repository>>
            -Session db
            +create_message(user_id, message_data) ChatMessage
            +get_conversation_history(user_id, limit) list[ChatMessage]
            +delete_conversation(user_id) bool
        }

        class ChatbotService {
            <<Service>>
            -ChatMessageRepository message_repo
            -AICoachService ai_coach
            +send_message(user_id, message) ChatMessage
            +get_conversation_history(user_id) list[ChatMessage]
            +clear_conversation(user_id) bool
        }

        class MessageRole {
            <<Enumeration>>
            USER
            AI_COACH
        }
    }

    %% ========== NOTIFICATION MODULE ==========
    
    namespace NotificationModule {
        class Notification {
            <<Entity>>
            +int id
            +int user_id
            +NotificationType notification_type
            +string title
            +string message
            +boolean is_read
            +datetime scheduled_time
            +datetime sent_at
            +datetime created_at
        }

        class NotificationRepository {
            <<Repository>>
            -Session db
            +create_notification(user_id, notification_data) Notification
            +get_by_user_id(user_id) list[Notification]
            +mark_as_read(notification_id) Notification
            +get_unread_count(user_id) int
            +delete_notification(notification_id) bool
        }

        class NotificationService {
            <<Service>>
            -NotificationRepository notification_repo
            +schedule_workout_reminder(user_id, workout_time) Notification
            +schedule_meal_reminder(user_id, meal_time) Notification
            +send_progress_update(user_id, progress_data) Notification
            +send_motivational_message(user_id) Notification
            +get_user_notifications(user_id) list[Notification]
            +mark_notification_read(notification_id) Notification
        }

        class NotificationType {
            <<Enumeration>>
            WORKOUT_REMINDER
            MEAL_REMINDER
            PROGRESS_UPDATE
            MOTIVATIONAL
            SYSTEM
        }
    }

    %% ========== AI SERVICES MODULE ==========
    
    namespace AIServicesModule {
        class AICoachService {
            <<Service>>
            -GroqAPI groq_client
            -VectorStore vector_store
            -ProfileService profile_service
            +generate_workout_plan(profile, plan_preferences) WorkoutPlan
            +generate_nutrition_plan(profile, plan_preferences) NutritionPlan
            +adapt_plan(user_id, progress_data) void
            +chat_with_user(message, conversation_history, profile) str
            +generate_motivational_message(profile) str
        }

        class MealScannerService {
            <<Service>>
            -VisionAPI vision_client
            +analyze_food_image(image) dict
            +identify_food_items(image) list[str]
            +estimate_nutrition(food_items) dict
        }

        class VoiceTranscriberService {
            <<Service>>
            -SpeechAPI speech_client
            +transcribe_audio(audio_file, language) str
            +supported_languages() list[str]
        }
    }

    %% ========== SHARED COMPONENTS ==========
    
    namespace SharedModule {
        class BaseRepository {
            <<Abstract Repository>>
            #Session db
            +get_by_id(id) T
            +get_all() list[T]
            +create(data) T
            +update(id, data) T
            +delete(id) bool
        }

        class EmailService {
            <<Service>>
            -SMTPConfig smtp_config
            +send_email(recipient, subject, body) bool
            +send_html_email(recipient, subject, html_body) bool
        }

        class RedisClient {
            <<Service>>
            -Redis redis_instance
            +get_client() Redis
            +close() void
        }
    }

    %% ========== RELATIONSHIPS ==========

    %% Auth Module Relationships
    AuthService --> UserRepository : uses
    AuthService --> VerificationService : uses
    AuthService --> AuthEmailService : uses
    AuthService --> SecurityUtils : uses
    UserRepository --> User : manages
    VerificationService --> RedisClient : uses
    OTPService --> RedisClient : uses
    AuthEmailService --> EmailService : uses

    %% Profile Module Relationships
    ProfileService --> ProfileRepository : uses
    ProfileRepository --> Profile : manages
    Profile --> Gender : uses
    Profile --> ActivityLevel : uses
    Profile --> FitnessGoal : uses

    %% Planning Module Relationships
    PlanningService --> WorkoutPlanRepository : uses
    PlanningService --> NutritionPlanRepository : uses
    PlanningService --> AICoachService : uses
    PlanningService --> ProfileService : fetches_profile
    AICoachService --> ProfileService : reads_profile
    WorkoutPlanRepository --> WorkoutPlan : manages
    NutritionPlanRepository --> NutritionPlan : manages
    WorkoutPlan "1" --> "*" WorkoutDay : contains
    WorkoutDay "1" --> "*" Exercise : contains
    NutritionPlan "1" --> "*" Meal : contains

    %% Tracking Module Relationships
    TrackingService --> WorkoutLogRepository : uses
    TrackingService --> MealLogRepository : uses
    TrackingService --> WeightLogRepository : uses
    TrackingService --> MealScannerService : uses
    TrackingService --> VoiceTranscriberService : uses
    WorkoutLogRepository --> WorkoutLog : manages
    MealLogRepository --> MealLog : manages
    WeightLogRepository --> WeightLog : manages
    MealLog --> LogMethod : uses
    WorkoutLog --> Exercise : references

    %% Chatbot Module Relationships
    ChatbotService --> ChatMessageRepository : uses
    ChatbotService --> AICoachService : uses
    ChatMessageRepository --> ChatMessage : manages
    ChatMessage --> MessageRole : uses

    %% Notification Module Relationships
    NotificationService --> NotificationRepository : uses
    NotificationRepository --> Notification : manages
    Notification --> NotificationType : uses

    %% Cross-Module Relationships
    User "1" --> "0..1" Profile : has
    User "1" --> "*" WorkoutPlan : requests
    User "1" --> "*" NutritionPlan : requests
    User "1" --> "*" WorkoutLog : creates
    User "1" --> "*" MealLog : creates
    User "1" --> "*" WeightLog : creates
    User "1" --> "*" ChatMessage : exchanges
    User "1" --> "*" Notification : receives

    %% Inheritance
    UserRepository --|> BaseRepository
    ProfileRepository --|> BaseRepository
    WorkoutPlanRepository --|> BaseRepository
    NutritionPlanRepository --|> BaseRepository
    WorkoutLogRepository --|> BaseRepository
    MealLogRepository --|> BaseRepository
    WeightLogRepository --|> BaseRepository
    ChatMessageRepository --|> BaseRepository
    NotificationRepository --|> BaseRepository
