// FitMind Database Schema - Entity Relationship Diagram
// Use dbdiagram.io to visualize this schema
// Project: FitMind - AI-Powered Fitness & Nutrition Coaching Platform

Project FitMind {
  database_type: 'PostgreSQL'
  Note: 'FitMind Database Schema - Comprehensive ERD for all modules'
}

// ========================================
// ENUM DEFINITIONS
// ========================================

Enum gender_enum {
  male
  female
}

Enum fitness_goal_enum {
  lose_weight
  try_ai_coach
  get_bulks
  improve_endurance
}

Enum activity_level_enum {
  sedentary
  lightly_active
  moderately_active
  very_active
  extra_active
}

Enum meal_type_enum {
  breakfast
  lunch
  dinner
  snack
}

Enum difficulty_enum {
  Beginner
  Intermediate
  Advanced
}

Enum exercise_type_enum {
  Strength
  Cardio
  Flexibility
  Balance
  HIIT
}

Enum location_enum {
  Gym
  Home
  Outdoor
  Any
}

Enum source_enum {
  System
  USDA
  Manual
}

// ========================================
// AUTHENTICATION MODULE
// ========================================

Table users {
  id integer [pk, increment]
  name varchar
  email varchar [unique]
  password varchar
  is_verified boolean [default: false]
  created_at timestamptz
  updated_at timestamptz

  Note: 'Core user authentication and account management'
}

// ========================================
// PROFILE MODULE
// ========================================

Table profiles {
  id integer [pk, increment]
  user_id integer [unique, ref: > users.id]
  age integer
  gender varchar [note: 'Enum: male, female']
  height float
  weight float
  fitness_goal varchar [note: 'Enum: lose_weight, try_ai_coach, get_bulks, improve_endurance']
  activity_level varchar [note: 'Enum: sedentary, lightly_active, moderately_active, very_active, extra_active']
  dietary_preference varchar
  medical_conditions varchar
  allergies varchar
  injuries varchar
  medications varchar
  updated_at timestamptz

  Note: 'Comprehensive user health and fitness profile for AI personalization'
}

// ========================================
// CATALOG MODULE - CENTRAL EXERCISE LIBRARY
// ========================================

Table central_exercises {
  id integer [pk, increment]
  name varchar(255)
  exercise_type varchar [default: 'Strength', note: 'Enum: Strength, Cardio, Flexibility, Balance, HIIT']
  primary_muscle_group varchar [default: 'Full Body']
  secondary_muscles varchar [null]
  equipment_required varchar [default: 'Bodyweight']
  difficulty_level varchar [default: 'Beginner', note: 'Enum: Beginner, Intermediate, Advanced']
  location varchar [default: 'Any', note: 'Enum: Gym, Home, Outdoor, Any']
  instructions text [null]
  video_url varchar [null]
  image_url varchar [null]
  source varchar [default: 'System']
  created_by_user_id integer [ref: > users.id, null]
  is_verified boolean [default: true]
  is_public boolean [default: true]
  is_active boolean [default: true]
  created_at timestamptz
  name_embedding "vector(384)" [null, note: 'pgvector embedding for semantic search']

  Note: 'Central exercise catalog — shared across all users, referenced by plans and logs'
}

// ========================================
// CATALOG MODULE - CENTRAL FOOD LIBRARY
// ========================================

Table central_foods {
  id integer [pk, increment]
  food_name varchar(255)
  food_name_ar varchar(255) [null, note: 'Arabic food name']
  food_category varchar [null]

  // Macros per 100g
  calories_per_100g float
  protein_per_100g float
  carbs_per_100g float
  fats_per_100g float
  fiber_per_100g float [null]

  // Serving info
  serving_size_g float [null]
  serving_description varchar [null]

  // Metadata
  dietary_tags json [default: '[]', note: 'Array: [vegan, vegetarian, gluten-free, high-protein, etc.]']
  usda_fdc_id integer [null, note: 'USDA FoodData Central FDC ID']
  name_embedding "vector(384)" [null, note: 'pgvector embedding for semantic search']
  created_by_user_id integer [ref: > users.id, null]
  is_verified boolean [default: true]
  is_public boolean [default: true]
  source varchar [default: 'USDA', note: 'Data source: USDA or Manual']
  is_active boolean [default: true]
  created_at timestamptz

  Note: 'Central food catalog — USDA Foundation Foods + manual entries. Used for food logging search and AI context during plan generation.'
}

// ========================================
// PLANNING MODULE - WORKOUT
// ========================================

Table workout_plans {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  profile_id integer [ref: > profiles.id]
  plan_name varchar(255)
  description text [null]
  start_date date
  end_date date [null]
  frequency varchar [null]
  difficulty_level varchar [null]
  estimated_duration_per_session integer [null, note: 'Minutes per session']
  generated_from_preferences json [null]
  language varchar(5) [default: 'en']
  created_at timestamptz
  updated_at timestamptz

  Note: 'AI-generated personalized workout plans based on Profile and user preferences'
}

Table workout_days {
  id integer [pk, increment]
  workout_plan_id integer [ref: > workout_plans.id]
  day_name varchar(100)
  day_number integer
  focus_area varchar [null]
  estimated_duration integer [null, note: 'Estimated duration in minutes']
  notes text [null]

  Note: 'Individual workout sessions within a plan'
}

Table workout_day_exercises {
  id integer [pk, increment]
  workout_day_id integer [ref: > workout_days.id]
  central_exercise_id integer [ref: > central_exercises.id]
  sets integer [null]
  reps integer [null]
  weight_kg float [null]
  duration_seconds integer [null]
  rest_seconds integer [null]
  order_index integer [default: 0]
  notes text [null]

  Note: 'Junction: links a workout day to exercises from the central catalog with user-specific parameters'
}

// ========================================
// PLANNING MODULE - NUTRITION
// ========================================

Table nutrition_plans {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  profile_id integer [ref: > profiles.id]
  plan_name varchar(255)
  description text [null]
  start_date date
  end_date date [null]
  daily_calories integer
  daily_protein_g integer
  daily_carbs_g integer
  daily_fats_g integer
  generated_from_preferences json [null]
  language varchar(5) [default: 'en']
  created_at timestamptz
  updated_at timestamptz

  Note: 'AI-generated personalized nutrition plans based on Profile and user preferences'
}

Table nutrition_plan_days {
  id integer [pk, increment]
  nutrition_plan_id integer [ref: > nutrition_plans.id]
  day_number integer
  day_name varchar(50)
  notes text [null]

  Note: 'Individual days within a nutrition plan'
}

Table nutrition_plan_meals {
  id integer [pk, increment]
  nutrition_plan_day_id integer [ref: > nutrition_plan_days.id]
  meal_type varchar(50)
  meal_name varchar(255)
  calories integer
  protein_g float
  carbs_g float
  fats_g float
  fiber_g float [null]
  instructions text [null]
  prep_time_minutes integer [null]
  cook_time_minutes integer [null]
  servings float [default: 1.0]
  order_index integer [default: 0]
  notes text [null]

  Note: 'AI-generated meals within a nutrition plan day'
}

Table nutrition_plan_meal_ingredients {
  id integer [pk, increment]
  nutrition_plan_meal_id integer [ref: > nutrition_plan_meals.id]
  central_food_id integer [ref: > central_foods.id]
  amount_g float

  Note: 'Junction: links a meal to foods from the central catalog with amounts'
}

// ========================================
// TRACKING MODULE
// ========================================

Table workout_logs {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  central_exercise_id integer [ref: > central_exercises.id, null]
  workout_day_exercise_id integer [ref: > workout_day_exercises.id, null]
  log_date date
  sets_completed integer
  reps_completed integer
  weight_used float [null]
  duration_seconds integer [null]
  notes text [null]
  created_at timestamptz

  Note: 'User workout tracking — optionally references central catalog and/or a planned exercise slot'
}

Table meal_logs {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  central_food_id integer [ref: > central_foods.id, null]
  log_date date
  meal_type varchar [note: 'Enum: breakfast, lunch, dinner, snack']
  meal_name varchar
  servings float [default: 1.0]
  serving_size_g_snapshot float [null, note: 'Snapshot of serving_size_g from central_foods at log time']
  serving_description_snapshot varchar [null, note: 'Snapshot of serving_description from central_foods at log time']
  calories float
  protein_g float
  carbs_g float
  fats_g float
  log_method varchar
  image_url varchar [null]
  created_at timestamptz

  Note: 'User meal logging — central_food_id is set when matched to catalog; null for free-text entries'
}

Table weight_logs {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  log_date date
  weight float
  notes text [null]
  created_at timestamptz

  Note: 'User weight tracking for progress monitoring'
}

Table sleep_logs {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  log_date date
  sleep_hours float
  sleep_quality integer
  notes text [null]
  created_at timestamptz

  Note: 'User sleep tracking for recovery and wellness monitoring'
}

Table hydration_logs {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  log_date date
  water_ml float
  notes text [null]
  created_at timestamptz

  Note: 'User hydration tracking'
}

// ========================================
// NOTIFICATION MODULE
// ========================================

Table device_tokens {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  token varchar [unique]
  platform varchar(20)
  is_active boolean [default: true]
  created_at timestamptz
  updated_at timestamptz

  Note: 'Push notification device tokens for FCM/APNs'
}

Table notification_preferences {
  id integer [pk, increment]
  user_id integer [unique, ref: > users.id]
  meal_reminders_enabled boolean [default: true]
  workout_reminders_enabled boolean [default: true]
  hydration_reminders_enabled boolean [default: true]
  sleep_reminders_enabled boolean [default: true]
  hydration_interval_hours integer [default: 2]
  meal_reminder_minutes_before integer [default: 15]
  workout_reminder_hour integer [default: 7]
  sleep_reminder_hour integer [default: 21]
  coaching_reminders_enabled boolean [default: true]
  coaching_daily_hour integer [default: 20]
  created_at timestamptz
  updated_at timestamptz

  Note: 'Per-user notification preferences and scheduling configuration'
}

// ========================================
// RECOMMENDATIONS MODULE
// ========================================

Table coaching_messages {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  category varchar(30)
  urgency varchar(20)
  title varchar(200)
  body text
  is_read boolean [default: false]
  is_dismissed boolean [default: false]
  created_at timestamptz

  Note: 'AI-generated coaching messages and recommendations for users'
}

// ========================================
// TABLE GROUPS (for visual organization)
// ========================================

TableGroup auth {
  users
}

TableGroup profile {
  profiles
}

TableGroup planning {
  central_exercises
  central_foods
  workout_plans
  workout_days
  workout_day_exercises
  nutrition_plans
  nutrition_plan_days
  nutrition_plan_meals
  nutrition_plan_meal_ingredients
}

TableGroup tracking {
  workout_logs
  meal_logs
  weight_logs
  sleep_logs
  hydration_logs
}

TableGroup notifications {
  device_tokens
  notification_preferences
}

TableGroup recommendations {
  coaching_messages
}
