---
title: FitMind Design - Repositories (Data Access Layer)
---
classDiagram
    %% ========== BASE REPOSITORY ==========

    class BaseRepository~T~ {
        <<Abstract Repository>>
        #Session db
        +get_by_id(id) T
        +get_by_filter(filter) T
        +get_all_by_filter(filter) list[T]
        +create(data) T
        +update(id, data) T
        +delete(id) bool
        +exists(filter) bool
    }

    %% ========== AUTHENTICATION MODULE - REPOSITORIES ==========

    namespace AuthModule {
        class UserRepository {
            <<Repository>>
            +get_by_email(email) User
            +email_exists(email) bool
            +create_user(name, email, hashed_pw) User
            +update_password(user, hashed_pw) User
            +mark_as_verified(user) User
        }
    }

    %% ========== PROFILE MODULE - REPOSITORIES ==========

    namespace ProfileModule {
        class ProfileRepository {
            <<Repository>>
            +get_by_user_id(user_id) Profile
            +create_profile(user_id, data) Profile
        }
    }

    %% ========== PLANNING MODULE - REPOSITORIES ==========

    namespace PlanningModule {
        class WorkoutPlanRepository {
            <<Repository>>
            +get_by_user_id(user_id) list[WorkoutPlan]
            +get_active_plan(user_id) WorkoutPlan
            +get_with_full_details(plan_id) WorkoutPlan
            +create_plan(data) WorkoutPlan
            +update_plan(plan_id, data) WorkoutPlan
            +delete_plan(plan_id) bool
            +get_days_by_plan_id(plan_id) list[WorkoutDay]
            +get_day_with_exercises(day_id) WorkoutDay
            +create_day(data) WorkoutDay
            +get_exercises_by_day_id(day_id) list
            +create_exercise_slot(data) WorkoutDayExercise
            +delete_exercise_slots_by_day_id(day_id) bool
        }

        class NutritionPlanRepository {
            <<Repository>>
            +get_by_user_id(user_id) list[NutritionPlan]
            +get_active_plan(user_id) NutritionPlan
            +get_with_full_details(plan_id) NutritionPlan
            +create_plan(data) NutritionPlan
            +update_plan(plan_id, data) NutritionPlan
            +delete_plan(plan_id) bool
            +get_days_by_plan_id(plan_id) list[NutritionPlanDay]
            +create_day(data) NutritionPlanDay
            +get_meals_by_day_id(day_id) list[NutritionPlanMeal]
            +get_meals_by_type(day_id, type) list
            +create_meal_slot(data) NutritionPlanMeal
            +delete_meal_slots_by_day_id(day_id) bool
        }

        class CentralFoodRepository {
            <<Repository>>
            +get_by_name(name) CentralFood
            +search(query) list[CentralFood]
            +create_manual_food(data) CentralFood
            +search_by_vector(embedding) list[CentralFood]
            +set_embedding(food_id, embedding) void
            +find_or_create(data) CentralFood
            +get_diet_friendly_foods_for_ai(prefs) list
        }

        class CentralExerciseRepository {
            <<Repository>>
            +get_by_name(name) CentralExercise
            +search(query) list[CentralExercise]
            +create_manual_exercise(data) CentralExercise
            +search_by_vector(embedding) list[CentralExercise]
            +set_embedding(exercise_id, embedding) void
            +find_or_create(data) CentralExercise
        }
    }

    %% ========== TRACKING MODULE - REPOSITORIES ==========

    namespace TrackingModule {
        class WorkoutLogRepository {
            <<Repository>>
            +create_log(user_id, data) WorkoutLog
            +list_logs(user_id, filters) list[WorkoutLog]
            +list_logs_since(user_id, since) list[WorkoutLog]
        }

        class MealLogRepository {
            <<Repository>>
            +create_log(user_id, data) MealLog
            +list_logs(user_id, filters) list[MealLog]
            +list_logs_since(user_id, since) list[MealLog]
        }

        class WeightLogRepository {
            <<Repository>>
            +create_log(user_id, data) WeightLog
            +list_logs(user_id, filters) list[WeightLog]
            +list_logs_since(user_id, since) list[WeightLog]
        }

        class SleepLogRepository {
            <<Repository>>
            +create_log(user_id, data) SleepLog
            +list_logs(user_id, filters) list[SleepLog]
            +list_logs_since(user_id, since) list[SleepLog]
        }

        class HydrationLogRepository {
            <<Repository>>
            +create_log(user_id, data) HydrationLog
            +list_logs(user_id, filters) list[HydrationLog]
            +list_logs_since(user_id, since) list[HydrationLog]
        }
    }

    %% ========== NOTIFICATION MODULE - REPOSITORIES ==========

    namespace NotificationModule {
        class DeviceTokenRepository {
            <<Repository>>
            +upsert(user_id, token, platform) DeviceToken
            +deactivate(user_id, token) void
            +get_active_tokens_for_user(user_id) list[DeviceToken]
        }

        class NotificationPreferenceRepository {
            <<Repository>>
            +get_or_create(user_id) NotificationPreference
            +update(user_id, prefs) NotificationPreference
            +get_with_coaching_enabled() list[NotificationPreference]
        }
    }

    %% ========== RECOMMENDATION MODULE - REPOSITORIES ==========

    namespace RecommendationModule {
        class CoachingMessageRepository {
            <<Repository>>
            +create(user_id, data) CoachingMessage
            +list_for_user(user_id) list[CoachingMessage]
            +count_unread(user_id) int
            +mark_read(message_id) CoachingMessage
            +mark_all_read(user_id) bool
            +dismiss(message_id) CoachingMessage
        }
    }

    %% ========== INHERITANCE RELATIONSHIPS ==========

    UserRepository --|> BaseRepository~T~
    ProfileRepository --|> BaseRepository~T~
    WorkoutPlanRepository --|> BaseRepository~T~
    NutritionPlanRepository --|> BaseRepository~T~
    CentralFoodRepository --|> BaseRepository~T~
    CentralExerciseRepository --|> BaseRepository~T~
    WorkoutLogRepository --|> BaseRepository~T~
    MealLogRepository --|> BaseRepository~T~
    WeightLogRepository --|> BaseRepository~T~
    SleepLogRepository --|> BaseRepository~T~
    HydrationLogRepository --|> BaseRepository~T~
    DeviceTokenRepository --|> BaseRepository~T~
    NotificationPreferenceRepository --|> BaseRepository~T~
    CoachingMessageRepository --|> BaseRepository~T~

    %% ========== REPOSITORY RELATIONSHIPS ==========

    WorkoutPlanRepository ..> CentralExerciseRepository : references_exercises
    NutritionPlanRepository ..> CentralFoodRepository : references_foods
    WorkoutLogRepository ..> CentralExerciseRepository : references
    MealLogRepository ..> CentralFoodRepository : references
