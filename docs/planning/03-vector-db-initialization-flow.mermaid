sequenceDiagram
    participant Admin
    participant Script as setup_vector_db.py
    participant Scraper as FitnessResourceScraper
    participant Web as Websites & PDFs
    participant VectorDB as VectorDBService
    participant Embeddings as HuggingFaceEmbeddings
    participant ChromaDB
    participant FileSystem

    Admin->>+Script: python scripts/setup_vector_db.py
    
    rect rgb(230, 240, 255)
        Note over Script,Web: Step 1: Scrape Resources
        Script->>+Scraper: scrape_all_resources(max=999, priority="HIGH")
        
        loop For each HIGH priority resource (17 total)
            Scraper->>+Web: HTTP GET {url}
            
            alt URL is PDF
                Web-->>Scraper: PDF binary
                Scraper->>Scraper: PdfReader.extract_text()
                Note over Scraper: Extract from all pages<br/>Clean formatting
            else URL is web page
                Web-->>-Scraper: HTML
                Scraper->>Scraper: BeautifulSoup.parse()<br/>Remove scripts, nav, footer<br/>Extract main content
            end
            
            Scraper->>Scraper: Create document:<br/>{content, metadata}<br/>metadata: {source, title,<br/>category, organization}
        end
        
        Scraper->>+FileSystem: Write JSON file
        FileSystem-->>-Scraper: data/scraped_resources/<br/>scraped_documents.json
        Scraper-->>-Script: 17 documents extracted
    end
    
    rect rgb(255, 240, 230)
        Note over Script,ChromaDB: Step 2: Build Vector Database
        Script->>+VectorDB: create_vector_db(force_recreate=True)
        
        VectorDB->>+FileSystem: Load scraped_documents.json
        FileSystem-->>-VectorDB: List of 17 documents
        
        VectorDB->>VectorDB: RecursiveCharacterTextSplitter:<br/>chunk_size=1000<br/>chunk_overlap=200
        Note over VectorDB: Split 1.4M characters<br/>→ 1944 chunks
        
        VectorDB->>+Embeddings: Initialize all-MiniLM-L6-v2
        Note over Embeddings: Download model (~90MB)<br/>First time only
        Embeddings-->>-VectorDB: Ready
        
        loop For each chunk (1944 total)
            VectorDB->>+Embeddings: encode(chunk_text)
            Embeddings-->>-VectorDB: 384-dimensional vector
        end
        
        VectorDB->>+ChromaDB: Create collection "fitness_knowledge"<br/>Add documents with embeddings
        ChromaDB->>+FileSystem: Persist to disk<br/>app/ai_services/ai_coach/chroma_db/
        FileSystem-->>-ChromaDB: chroma.sqlite3 + indexes
        ChromaDB-->>-VectorDB: Success
        
        VectorDB-->>-Script: Database created:<br/>1944 chunks indexed
    end
    
    rect rgb(230, 255, 230)
        Note over Script: Step 3: Test Queries
        Script->>+VectorDB: get_context("muscle building", k=3)
        VectorDB->>+ChromaDB: similarity_search()
        ChromaDB-->>-VectorDB: Top 3 relevant chunks
        VectorDB-->>-Script: Context text
        
        Script->>Script: Display results:<br/>✓ Vector store created<br/>✓ 17 documents loaded<br/>✓ 1944 chunks indexed<br/>✓ Test query successful
    end
    
    Script-->>-Admin: Setup complete!<br/>AI Coach ready to use
