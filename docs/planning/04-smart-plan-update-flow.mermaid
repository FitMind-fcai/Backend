sequenceDiagram
    actor User
    participant PlanService
    participant WorkoutRepo
    participant AICoach
    participant VectorDB
    participant DB

    User->>+PlanService: generate_workout_plan(preferences)
    
    PlanService->>+WorkoutRepo: get_active_workout_plan(user_id)
    WorkoutRepo->>+DB: SELECT * FROM workout_plans<br/>WHERE user_id = ? AND end_date >= NOW()
    DB-->>-WorkoutRepo: Existing plan or None
    WorkoutRepo-->>-PlanService: existing_plan
    
    alt No existing plan
        rect rgb(230, 255, 230)
            Note over PlanService,AICoach: CREATE NEW PLAN
            PlanService->>+AICoach: generate_workout_plan(<br/>  profile, preferences,<br/>  existing_plan=None)
            Note over AICoach: Prompt: "Generate new plan<br/>from scratch"
            AICoach->>+VectorDB: get_context(query, k=5)
            VectorDB-->>-AICoach: RAG context
            AICoach->>AICoach: Use RAG context<br/>Create complete plan
            AICoach-->>-PlanService: New WorkoutPlanDTO
            
            PlanService->>WorkoutRepo: create_workout_plan()
            WorkoutRepo->>DB: INSERT new plan
        end
    else Plan exists
        rect rgb(255, 240, 230)
            Note over PlanService,AICoach: SMART UPDATE
            PlanService->>+AICoach: generate_workout_plan(<br/>  profile, preferences,<br/>  existing_plan=WorkoutPlanDTO)
            
            AICoach->>AICoach: Compare old vs new preferences:<br/>- Location changed?<br/>- Equipment changed?<br/>- Focus changed?<br/>- Difficulty changed?
            
            Note over AICoach: Prompt: "UPDATE existing plan<br/>KEEP: Compatible exercises<br/>CHANGE: Conflicting exercises"
            
            par Analyze existing plan
                Note over AICoach: Extract existing structure:<br/>- 5 days, Upper/Lower split<br/>- Exercises: Bench, Squat, etc.
            and Get RAG context
                AICoach->>+VectorDB: get_context(query, k=5)
                VectorDB-->>-AICoach: Relevant knowledge
            end
            
            Note over AICoach: Generate updated plan:<br/>- Keep: Exercises matching new prefs<br/>- Update: Only conflicting parts<br/>- Maintain: Progression & familiarity
            
            AICoach-->>-PlanService: Updated WorkoutPlanDTO
            
            PlanService->>WorkoutRepo: update_workout_plan(plan_id)
            WorkoutRepo->>DB: UPDATE plan<br/>DELETE old exercises<br/>INSERT new exercises
        end
    end
    
    PlanService-->>-User: Plan generated/updated
