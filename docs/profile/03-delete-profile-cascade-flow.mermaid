sequenceDiagram
    actor User
    participant API as FastAPI Route
    participant ProfileService
    participant ProfileRepo as ProfileRepository
    participant PlanRepo as PlanRepository
    participant DB as PostgreSQL

    User->>+API: DELETE /profiles/{profile_id}<br/>Header: Bearer {token}
    Note over API: JWT middleware extracts user_id
    
    API->>+ProfileService: delete_profile(user_id, profile_id)
    
    rect rgb(230, 240, 255)
        Note over ProfileService,DB: Step 1: Verify Ownership
        ProfileService->>+ProfileRepo: get_profile_by_id(profile_id)
        ProfileRepo->>+DB: SELECT * FROM profiles<br/>WHERE id = ?
        DB-->>-ProfileRepo: Profile or None
        ProfileRepo-->>-ProfileService: ProfileDTO or None
        
        alt Profile not found
            ProfileService-->>API: HTTPException(404,<br/>"Profile not found")
            API-->>User: 404 Not Found
        end
        
        alt Profile belongs to different user
            ProfileService-->>API: HTTPException(403,<br/>"Not authorized")
            API-->>User: 403 Forbidden
        end
    end
    
    rect rgb(255, 220, 220)
        Note over ProfileService,DB: Step 2: Cascade Delete Related Plans
        ProfileService->>+PlanRepo: Check related plans
        PlanRepo->>+DB: SELECT COUNT(*) FROM workout_plans<br/>WHERE profile_id = ?
        DB-->>PlanRepo: Workout plan count
        PlanRepo->>+DB: SELECT COUNT(*) FROM nutrition_plans<br/>WHERE profile_id = ?
        DB-->>-PlanRepo: Nutrition plan count
        PlanRepo-->>-ProfileService: Related plan counts
        
        Note over ProfileService: Plans will be cascade deleted<br/>by database foreign key constraint
    end
    
    rect rgb(255, 230, 230)
        Note over ProfileService,DB: Step 3: Delete Profile
        ProfileService->>+ProfileRepo: delete(profile_id)
        ProfileRepo->>+DB: BEGIN TRANSACTION
        
        Note over DB: CASCADE DELETE (FK constraints)
        DB->>DB: DELETE FROM exercises<br/>WHERE workout_day_id IN<br/>(SELECT id FROM workout_days<br/>WHERE workout_plan_id IN<br/>(SELECT id FROM workout_plans<br/>WHERE profile_id = ?))
        
        DB->>DB: DELETE FROM workout_days<br/>WHERE workout_plan_id IN<br/>(SELECT id FROM workout_plans<br/>WHERE profile_id = ?)
        
        DB->>DB: DELETE FROM workout_plans<br/>WHERE profile_id = ?
        
        DB->>DB: DELETE FROM meals<br/>WHERE nutrition_plan_id IN<br/>(SELECT id FROM nutrition_plans<br/>WHERE profile_id = ?)
        
        DB->>DB: DELETE FROM nutrition_plans<br/>WHERE profile_id = ?
        
        DB->>DB: DELETE FROM profiles<br/>WHERE id = ?
        
        DB-->>ProfileRepo: COMMIT TRANSACTION
        DB-->>-ProfileRepo: Profile and related data deleted
        ProfileRepo-->>-ProfileService: Success
        
        ProfileService-->>-API: {message: "Profile deleted"}
    end
    
    API-->>-User: 200 OK<br/>"Profile and all related plans deleted"
    
    Note over User,DB: WARNING: This action is irreversible<br/>Deletes profile + all workout/nutrition plans
