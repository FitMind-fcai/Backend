sequenceDiagram
    participant API as FastAPI Route
    participant ProfileService
    participant Validator as Pydantic Validator

    API->>+ProfileService: create/update_profile(data)
    
    rect rgb(230, 240, 255)
        Note over ProfileService,Validator: Step 1: Numeric Field Validation
        ProfileService->>+Validator: Validate age
        
        alt age < 1 or age > 120
            Validator-->>ProfileService: ValidationError
            ProfileService-->>API: HTTPException(422,<br/>"Age must be 1-120")
        end
        
        Validator->>Validator: Validate height (1-300 cm)
        Validator->>Validator: Validate weight (1-500 kg)
        
        Validator-->>-ProfileService: Numeric validation passed
    end
    
    rect rgb(255, 240, 230)
        Note over ProfileService,Validator: Step 2: Enum Field Validation
        ProfileService->>+Validator: Validate gender
        
        alt Invalid enum value
            Validator-->>ProfileService: ValidationError
            ProfileService-->>API: HTTPException(422,<br/>"Invalid gender value")
        end
        
        Note over Validator: Valid enums:<br/>Gender: male/female/other<br/>FitnessGoal: weight_loss/muscle_gain/<br/>endurance/flexibility/general_fitness<br/>ActivityLevel: sedentary/lightly_active/<br/>moderately_active/very_active/<br/>extremely_active<br/>DietaryPreference: none/vegetarian/<br/>vegan/pescatarian/keto/<br/>paleo/mediterranean/halal/kosher
        
        Validator->>Validator: Validate fitness_goal
        Validator->>Validator: Validate activity_level
        Validator->>Validator: Validate dietary_preference
        
        Validator-->>-ProfileService: Enum validation passed
    end
    
    rect rgb(230, 255, 230)
        Note over ProfileService,Validator: Step 3: Optional Field Validation
        ProfileService->>+Validator: Validate optional lists
        
        Note over Validator: Optional fields (can be null):<br/>- injuries: List[str]<br/>- medical_conditions: List[str]<br/>- medications: List[str]<br/>- allergies: List[str]<br/>- notes: str
        
        Validator->>Validator: Check if provided lists are valid JSON arrays
        Validator->>Validator: Validate each string in lists
        
        alt Invalid list format
            Validator-->>ProfileService: ValidationError
            ProfileService-->>API: HTTPException(422,<br/>"Invalid list format")
        end
        
        Validator-->>-ProfileService: Optional field validation passed
    end
    
    ProfileService-->>-API: All validations passed<br/>Proceed with create/update
