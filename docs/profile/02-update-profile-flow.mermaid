sequenceDiagram
    actor User
    participant API as FastAPI Route
    participant ProfileService
    participant ProfileRepo as ProfileRepository
    participant DB as PostgreSQL

    User->>+API: PUT /profiles/{profile_id}<br/>Header: Bearer {token}<br/>{age, weight, fitness_goal, etc.}
    Note over API: JWT middleware extracts user_id
    
    API->>+ProfileService: update_profile(user_id, profile_id, update_data)
    
    rect rgb(230, 240, 255)
        Note over ProfileService,DB: Step 1: Verify Ownership
        ProfileService->>+ProfileRepo: get_profile_by_id(profile_id)
        ProfileRepo->>+DB: SELECT * FROM profiles<br/>WHERE id = ?
        DB-->>-ProfileRepo: Profile or None
        ProfileRepo-->>-ProfileService: ProfileDTO or None
        
        alt Profile not found
            ProfileService-->>API: HTTPException(404,<br/>"Profile not found")
            API-->>User: 404 Not Found
        end
        
        alt Profile belongs to different user
            ProfileService-->>API: HTTPException(403,<br/>"Not authorized")
            API-->>User: 403 Forbidden
        end
    end
    
    rect rgb(255, 240, 230)
        Note over ProfileService: Step 2: Validate Update Data
        ProfileService->>ProfileService: Validate changed fields:<br/>- Numeric ranges (age, height, weight)<br/>- Enum values<br/>- Optional field formats
        
        alt Validation fails
            ProfileService-->>API: HTTPException(422,<br/>"Validation error")
            API-->>User: 422 Unprocessable Entity
        end
        
        ProfileService->>ProfileService: Merge update with existing:<br/>Only update provided fields
    end
    
    rect rgb(230, 255, 230)
        Note over ProfileService,DB: Step 3: Update Profile
        ProfileService->>+ProfileRepo: update(profile_id, validated_data)
        ProfileRepo->>+DB: UPDATE profiles<br/>SET age = ?, weight = ?,<br/>fitness_goal = ?, ...,<br/>updated_at = NOW()<br/>WHERE id = ?
        DB-->>-ProfileRepo: Updated profile
        ProfileRepo-->>-ProfileService: UserProfileDTO
        
        ProfileService-->>-API: ProfileResponse
    end
    
    API-->>-User: 200 OK<br/>{id, user_id, updated fields}
    
    Note over User,DB: Active plans may need regeneration<br/>if fitness_goal or activity_level changed
