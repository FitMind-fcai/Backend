---
title: FitMind Design - Entities (Models)
---
classDiagram
    %% ========== AUTHENTICATION MODULE - ENTITIES ==========

    namespace AuthModule {
        class User {
            <<Entity>>
            +int id
            +string name
            +string email
            +string password
            +boolean is_verified
            +datetime created_at
            +datetime updated_at
        }
    }

    %% ========== PROFILE MODULE - ENTITIES ==========

    namespace ProfileModule {
        class Profile {
            <<Entity>>
            +int id
            +int user_id
            +int age
            +Gender gender
            +float height
            +float weight
            +FitnessGoal fitness_goal
            +ActivityLevel activity_level
            +string dietary_preference
            +string medical_conditions
            +string allergies
            +string injuries
            +string medications
            +datetime updated_at
        }

        class Gender {
            <<Enumeration>>
            MALE
            FEMALE
        }

        class ActivityLevel {
            <<Enumeration>>
            SEDENTARY
            LIGHTLY_ACTIVE
            MODERATELY_ACTIVE
            VERY_ACTIVE
            EXTRA_ACTIVE
        }

        class FitnessGoal {
            <<Enumeration>>
            LOSE_WEIGHT
            TRY_AI_COACH
            GET_BULKS
            IMPROVE_ENDURANCE
        }
    }

    %% ========== PLANNING MODULE - ENTITIES ==========

    namespace PlanningModule {
        class CentralExercise {
            <<Catalog Entity>>
            +int id
            +string name
            +string exercise_type
            +string primary_muscle_group
            +string secondary_muscles
            +string equipment_required
            +string difficulty_level
            +string location
            +text instructions
            +string video_url
            +string image_url
            +string source
            +int created_by_user_id
            +boolean is_verified
            +boolean is_public
            +boolean is_active
            +datetime created_at
            +Vector~384~ name_embedding
        }

        class CentralFood {
            <<Catalog Entity>>
            +int id
            +string food_name
            +string food_name_ar
            +string food_category
            +float calories_per_100g
            +float protein_per_100g
            +float carbs_per_100g
            +float fats_per_100g
            +float fiber_per_100g
            +float serving_size_g
            +string serving_description
            +JSON dietary_tags
            +int usda_fdc_id
            +Vector~384~ name_embedding
            +int created_by_user_id
            +boolean is_verified
            +boolean is_public
            +string source
            +boolean is_active
            +datetime created_at
        }

        class WorkoutPlan {
            <<Entity>>
            +int id
            +int user_id
            +int profile_id
            +string plan_name
            +text description
            +date start_date
            +date end_date
            +string frequency
            +string difficulty_level
            +int estimated_duration_per_session
            +JSON generated_from_preferences
            +string language
            +datetime created_at
            +datetime updated_at
        }

        class WorkoutDay {
            <<Entity>>
            +int id
            +int workout_plan_id
            +string day_name
            +int day_number
            +string focus_area
            +int estimated_duration
            +text notes
        }

        class WorkoutDayExercise {
            <<Junction Entity>>
            +int id
            +int workout_day_id
            +int central_exercise_id
            +int sets
            +int reps
            +float weight_kg
            +int duration_seconds
            +int rest_seconds
            +int order_index
            +text notes
        }

        class NutritionPlan {
            <<Entity>>
            +int id
            +int user_id
            +int profile_id
            +string plan_name
            +text description
            +date start_date
            +date end_date
            +int daily_calories
            +int daily_protein_g
            +int daily_carbs_g
            +int daily_fats_g
            +JSON generated_from_preferences
            +string language
            +datetime created_at
            +datetime updated_at
        }

        class NutritionPlanDay {
            <<Entity>>
            +int id
            +int nutrition_plan_id
            +int day_number
            +string day_name
            +text notes
        }

        class NutritionPlanMeal {
            <<Entity>>
            +int id
            +int nutrition_plan_day_id
            +string meal_type
            +string meal_name
            +int calories
            +float protein_g
            +float carbs_g
            +float fats_g
            +float fiber_g
            +text instructions
            +int prep_time_minutes
            +int cook_time_minutes
            +float servings
            +int order_index
            +text notes
        }

        class NutritionPlanMealIngredient {
            <<Junction Entity>>
            +int id
            +int nutrition_plan_meal_id
            +int central_food_id
            +float amount_g
        }
    }

    %% ========== TRACKING MODULE - ENTITIES ==========

    namespace TrackingModule {
        class WorkoutLog {
            <<Entity>>
            +int id
            +int user_id
            +int central_exercise_id
            +int workout_day_exercise_id
            +date log_date
            +int sets_completed
            +int reps_completed
            +float weight_used
            +int duration_seconds
            +text notes
            +datetime created_at
        }

        class MealLog {
            <<Entity>>
            +int id
            +int user_id
            +int central_food_id
            +date log_date
            +MealType meal_type
            +string meal_name
            +float servings
            +float serving_size_g_snapshot
            +string serving_description_snapshot
            +float calories
            +float protein_g
            +float carbs_g
            +float fats_g
            +string log_method
            +string image_url
            +datetime created_at
        }

        class WeightLog {
            <<Entity>>
            +int id
            +int user_id
            +date log_date
            +float weight
            +text notes
            +datetime created_at
        }

        class SleepLog {
            <<Entity>>
            +int id
            +int user_id
            +date log_date
            +float sleep_hours
            +int sleep_quality
            +text notes
            +datetime created_at
        }

        class HydrationLog {
            <<Entity>>
            +int id
            +int user_id
            +date log_date
            +float water_ml
            +text notes
            +datetime created_at
        }

        class MealType {
            <<Enumeration>>
            BREAKFAST
            LUNCH
            DINNER
            SNACK
        }
    }

    %% ========== NOTIFICATION MODULE - ENTITIES ==========

    namespace NotificationModule {
        class DeviceToken {
            <<Entity>>
            +int id
            +int user_id
            +string token
            +string platform
            +boolean is_active
            +datetime created_at
            +datetime updated_at
        }

        class NotificationPreference {
            <<Entity>>
            +int id
            +int user_id
            +boolean meal_reminders_enabled
            +boolean workout_reminders_enabled
            +boolean hydration_reminders_enabled
            +boolean sleep_reminders_enabled
            +int hydration_interval_hours
            +int meal_reminder_minutes_before
            +int workout_reminder_hour
            +int sleep_reminder_hour
            +boolean coaching_reminders_enabled
            +int coaching_daily_hour
            +datetime created_at
            +datetime updated_at
        }
    }

    %% ========== RECOMMENDATION MODULE - ENTITIES ==========

    namespace RecommendationModule {
        class CoachingMessage {
            <<Entity>>
            +int id
            +int user_id
            +string category
            +string urgency
            +string title
            +text body
            +boolean is_read
            +boolean is_dismissed
            +datetime created_at
        }
    }

    %% ========== RELATIONSHIPS BETWEEN ENTITIES ==========

    %% Core User Relationships
    User "1" --> "0..1" Profile : has
    User "1" --> "*" WorkoutPlan : creates
    User "1" --> "*" NutritionPlan : creates
    User "1" --> "*" WorkoutLog : logs
    User "1" --> "*" MealLog : logs
    User "1" --> "*" WeightLog : logs
    User "1" --> "*" SleepLog : logs
    User "1" --> "*" HydrationLog : logs
    User "1" --> "*" DeviceToken : registers
    User "1" --> "0..1" NotificationPreference : configures
    User "1" --> "*" CoachingMessage : receives

    %% Planning Module - Workout Relationships
    WorkoutPlan "1" --> "*" WorkoutDay : contains
    WorkoutDay "1" --> "*" WorkoutDayExercise : includes
    WorkoutDayExercise "*" --> "1" CentralExercise : references

    %% Planning Module - Nutrition Relationships
    NutritionPlan "1" --> "*" NutritionPlanDay : contains
    NutritionPlanDay "1" --> "*" NutritionPlanMeal : includes
    NutritionPlanMeal "1" --> "*" NutritionPlanMealIngredient : has
    NutritionPlanMealIngredient "*" --> "1" CentralFood : references

    %% Tracking Module Relationships
    WorkoutLog "*" --> "0..1" CentralExercise : references
    WorkoutLog "*" --> "0..1" WorkoutDayExercise : references
    MealLog "*" --> "0..1" CentralFood : references

    %% Catalog Ownership (optional)
    CentralExercise "*" --> "0..1" User : created_by
    CentralFood "*" --> "0..1" User : created_by

    %% Profile Enumerations
    Profile --> Gender : uses
    Profile --> ActivityLevel : uses
    Profile --> FitnessGoal : uses

    %% Tracking Enumerations
    MealLog --> MealType : uses
