---
title: FitMind Design - Features (Services & Business Logic)
---
classDiagram
    %% ========== AUTHENTICATION MODULE - SERVICES ==========
    
    namespace AuthModule {
        class AuthService {
            <<Service>>
            -UserRepository user_repo
            -VerificationService verification_service
            -AuthEmailService email_service
            +create_user(user_data) tuple[User, str]
            +authenticate_user(credentials) tuple[User, str]
            +verify_user_email(token) User
            +resend_verification(email) str
            +reset_user_password(user, new_password) void
            +get_user_by_email(email, require_verified) User
        }

        class VerificationService {
            <<Service>>
            -Redis redis_client
            +create_verification_token(email) str
            +validate_verification_token(token) str
            +delete_verification_token(token) void
            +get_token_ttl(token) int
        }

        class OTPService {
            <<Service>>
            -Redis redis_client
            +create_password_reset_otp(email) str
            +validate_otp(email, otp) bool
            +clear_otp(email) void
            +is_otp_valid(email) bool
            +get_otp_ttl(email) int
            +increment_attempt(email) void
        }

        class AuthEmailService {
            <<Service>>
            -EmailService base_email_service
            +send_verification_email(email, token) bool
            +send_resend_verification_email(email, token) bool
            +send_password_reset_otp(email, otp) bool
        }

        class SecurityUtils {
            <<Utility>>
            +hash_password(password) str
            +verify_password(plain_password, hashed_password) bool
            +create_access_token(user_id, email) str
            +verify_access_token(token) dict
            +generate_otp() str
            +hash_otp(otp) str
            +verify_otp(plain_otp, hashed_otp) bool
            +generate_verification_token() str
        }
    }

    %% ========== PROFILE MODULE - SERVICES ==========
    
    namespace ProfileModule {
        class ProfileService {
            <<Service>>
            -ProfileRepository profile_repo
            +create_profile(user_id, profile_data) Profile
            +get_profile_by_user_id(user_id) Profile
            +get_profile_by_id(profile_id) Profile
            +update_profile(user_id, profile_data) Profile
            +delete_profile(user_id) bool
        }
    }

    %% ========== PLANNING MODULE - SERVICES ==========
    
    namespace PlanningModule {
        class PlanGenerationService {
            <<Service>>
            -Session db
            -WorkoutPlanService workout_service
            -NutritionPlanService nutrition_service
            -WorkoutPlanRepository workout_plan_repo
            -WorkoutDayRepository workout_day_repo
            -ExerciseRepository exercise_repo
            -NutritionPlanRepository nutrition_plan_repo
            -MealRepository meal_repo
            +generate_workout_plan(profile, preferences, duration_weeks) WorkoutPlan
            +generate_nutrition_plan(profile, preferences, duration_weeks) NutritionPlan
            +get_user_active_plans(user_id) CombinedPlanResponse
        }

        class WorkoutPlanService {
            <<Service>>
            -Session db
            -WorkoutPlanRepository workout_plan_repo
            -WorkoutDayRepository workout_day_repo
            -ExerciseRepository exercise_repo
            +create_workout_plan(user_id, plan_data) WorkoutPlan
            +get_active_plan(user_id) WorkoutPlan
            +get_plan_with_details(plan_id) WorkoutPlan
            +get_all_plans(user_id) list[WorkoutPlan]
            +delete_plan(plan_id) bool
        }

        class NutritionPlanService {
            <<Service>>
            -Session db
            -NutritionPlanRepository nutrition_plan_repo
            -MealRepository meal_repo
            +create_nutrition_plan(user_id, plan_data) NutritionPlan
            +get_active_plan(user_id) NutritionPlan
            +get_plan_with_details(plan_id) NutritionPlan
            +get_all_plans(user_id) list[NutritionPlan]
            +delete_plan(plan_id) bool
        }
    }

    %% ========== TRACKING MODULE - SERVICES ==========
    
    namespace TrackingModule {
        class TrackingService {
            <<Service>>
            -WorkoutLogRepository workout_log_repo
            -MealLogRepository meal_log_repo
            -WeightLogRepository weight_log_repo
            -MealScannerService meal_scanner
            -VoiceTranscriberService voice_transcriber
            +log_workout(user_id, workout_data) WorkoutLog
            +log_meal_text(user_id, meal_data) MealLog
            +log_meal_voice(user_id, audio_file) MealLog
            +log_meal_camera(user_id, image_file) MealLog
            +log_weight(user_id, weight_data) WeightLog
            +get_progress_summary(user_id) dict
            +get_workout_history(user_id, days) list[WorkoutLog]
            +get_nutrition_history(user_id, days) list[MealLog]
            +get_weight_history(user_id, days) list[WeightLog]
        }

        class ProgressAnalyticsService {
            <<Service>>
            -WorkoutLogRepository workout_log_repo
            -MealLogRepository meal_log_repo
            -WeightLogRepository weight_log_repo
            +calculate_workout_adherence(user_id, period) float
            +calculate_nutrition_adherence(user_id, period) float
            +analyze_weight_trend(user_id, period) dict
            +generate_progress_report(user_id) dict
            +get_streak_count(user_id, log_type) int
            +predict_goal_achievement(user_id) dict
        }
    }

    %% ========== CHATBOT MODULE - SERVICES ==========
    
    namespace ChatbotModule {
        class ChatbotService {
            <<Service>>
            -ChatMessageRepository message_repo
            -AICoachService ai_coach
            -ProfileService profile_service
            +send_message(user_id, message) ChatMessage
            +get_conversation_history(user_id, limit) list[ChatMessage]
            +clear_conversation(user_id) bool
            +get_contextual_response(user_id, message) str
        }
    }

    %% ========== NOTIFICATION MODULE - SERVICES ==========
    
    namespace NotificationModule {
        class NotificationService {
            <<Service>>
            -NotificationRepository notification_repo
            -PushNotificationProvider push_provider
            +schedule_workout_reminder(user_id, workout_time) Notification
            +schedule_meal_reminder(user_id, meal_time) Notification
            +send_progress_update(user_id, progress_data) Notification
            +send_motivational_message(user_id) Notification
            +get_user_notifications(user_id) list[Notification]
            +mark_notification_read(notification_id) Notification
            +process_scheduled_notifications() void
        }

        class PushNotificationProvider {
            <<Service>>
            -FCMClient fcm_client
            +send_push_notification(user_device_token, notification_data) bool
            +send_batch_notifications(notifications) list[bool]
            +register_device_token(user_id, device_token) void
            +unregister_device_token(user_id, device_token) void
        }
    }

    %% ========== AI SERVICES MODULE ==========
    
    namespace AIServicesModule {
        class AICoachService {
            <<Service>>
            -str api_key
            -str model
            -Groq client
            -VectorDBService vector_db
            +generate_workout_plan(profile, preferences, duration_weeks, existing_plan) WorkoutPlanDTO
            +generate_nutrition_plan(profile, preferences, duration_weeks, existing_plan) NutritionPlanDTO
            +ask_coach(user_query, profile) str
            -_build_workout_prompt(profile, preferences, duration_weeks, rag_context, existing_plan) str
            -_build_nutrition_prompt(profile, preferences, duration_weeks, rag_context, existing_plan) str
            -_build_ask_coach_prompt(user_query, profile, rag_context) str
            -_call_llm(prompt) str
            -_extract_json_from_response(response) dict
        }

        class VectorDBService {
            <<Service>>
            -str persist_directory
            -str collection_name
            -HuggingFaceEmbeddings embeddings
            -Chroma vectorstore
            +get_context(query, k) str
            +similarity_search(query, k) list[Document]
            +create_vector_db(force_recreate) None
            +load_documents() list[Document]
            -_load_pdf_document() list[Document]
            -_load_scraped_documents() list[Document]
            -_split_documents(documents) list[Document]
        }

        class MealScannerService {
            <<Service - Future>>
            +analyze_food_image(image) dict
        }

        class VoiceTranscriberService {
            <<Service - Future>>
            +transcribe_audio(audio_file) str
        }
    }

    %% ========== SHARED SERVICES ==========
    
    namespace SharedModule {
        class EmailService {
            <<Service>>
            -SMTPConfig smtp_config
            +send_email(to_email, subject, body, from_email) bool
            +send_html_email(to_email, subject, html_content, from_email) bool
        }

        class RedisClient {
            <<Service>>
            -Redis redis_instance
            +get_client() Redis
        }
    }

    %% ========== SERVICE DEPENDENCIES ==========

    %% Auth Module Dependencies
    AuthService --> VerificationService : uses
    AuthService --> AuthEmailService : uses
    VerificationService --> RedisClient : uses
    OTPService --> RedisClient : uses
    AuthEmailService --> EmailService : uses

    %% Profile Module Dependencies
    ProfileService ..> PlanGenerationService : provides_profile_to

    %% Planning Module Dependencies
    PlanGenerationService --> WorkoutPlanService : uses
    PlanGenerationService --> NutritionPlanService : uses
    PlanGenerationService --> AICoachService : uses
    PlanGenerationService --> ProfileService : uses
    AICoachService --> VectorDBService : uses

    %% Tracking Module Dependencies (Future)
    
    %% Chatbot Module Dependencies (Future)
    
    %% Notification Module Dependencies (Future)
