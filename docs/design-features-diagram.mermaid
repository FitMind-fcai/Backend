---
title: FitMind Design - Features (Services & Business Logic)
---
classDiagram
    %% ========== AUTHENTICATION MODULE - SERVICES ==========

    namespace AuthModule {
        class AuthService {
            <<Service>>
            -UserRepository user_repo
            -VerificationService verification_service
            -AuthEmailService email_service
            +create_user(user_data) tuple[User, str]
            +authenticate_user(credentials) tuple[User, str]
            +verify_user_email(token) User
            +resend_verification(email) str
            +reset_user_password(user, new_password) void
            +get_user_by_email(email, require_verified) User
        }

        class VerificationService {
            <<Service>>
            -Redis redis_client
            +create_verification_token(email) str
            +validate_verification_token(token) str
            +delete_verification_token(token) void
            +get_token_ttl(token) int
        }

        class OTPService {
            <<Service>>
            -Redis redis_client
            +create_password_reset_otp(email) str
            +validate_otp(email, otp) bool
            +clear_otp(email) void
            +is_otp_valid(email) bool
            +get_otp_ttl(email) int
            +increment_attempt(email) void
        }

        class AuthEmailService {
            <<Service>>
            -EmailService base_email_service
            +send_verification_email(email, token) bool
            +send_resend_verification_email(email, token) bool
            +send_password_reset_otp(email, otp) bool
        }

        class SecurityUtils {
            <<Utility>>
            +hash_password(password) str
            +verify_password(plain, hashed) bool
            +create_access_token(user_id, email) str
            +verify_access_token(token) dict
            +generate_otp() str
            +hash_otp(otp) str
            +verify_otp(plain_otp, hashed_otp) bool
            +generate_verification_token() str
        }
    }

    %% ========== PROFILE MODULE - SERVICES ==========

    namespace ProfileModule {
        class ProfileService {
            <<Service>>
            -ProfileRepository profile_repo
            +create_profile(user_id, profile_data) Profile
            +get_profile_by_user_id(user_id) Profile
            +get_profile_by_id(profile_id) Profile
            +update_profile(user_id, profile_data) Profile
            +delete_profile(user_id) bool
        }
    }

    %% ========== PLANNING MODULE - SERVICES ==========

    namespace PlanningModule {
        class PlanGenerationService {
            <<Service>>
            -Session db
            -WorkoutPlanService workout_service
            -NutritionPlanService nutrition_service
            -ThreadPoolExecutor executor
            +generate_workout_plan(profile, preferences) WorkoutPlan
            +generate_nutrition_plan(profile, preferences) NutritionPlan
            +generate_combined_plans(profile, preferences) CombinedPlanResponse
            +get_user_active_plans(user_id) CombinedPlanResponse
        }

        class WorkoutPlanService {
            <<Service>>
            -Session db
            -WorkoutPlanRepository workout_plan_repo
            +create_workout_plan(user_id, plan_data) WorkoutPlan
            +get_active_plan(user_id) WorkoutPlan
            +get_plan_with_details(plan_id) WorkoutPlan
            +get_all_plans(user_id) list[WorkoutPlan]
            +delete_plan(plan_id) bool
        }

        class NutritionPlanService {
            <<Service>>
            -Session db
            -NutritionPlanRepository nutrition_plan_repo
            +create_nutrition_plan(user_id, plan_data) NutritionPlan
            +get_active_plan(user_id) NutritionPlan
            +get_plan_with_details(plan_id) NutritionPlan
            +get_all_plans(user_id) list[NutritionPlan]
            +delete_plan(plan_id) bool
        }
    }

    %% ========== TRACKING MODULE - SERVICES ==========

    namespace TrackingModule {
        class TrackingService {
            <<Service>>
            -WorkoutLogRepository workout_log_repo
            -MealLogRepository meal_log_repo
            -WeightLogRepository weight_log_repo
            -SleepLogRepository sleep_log_repo
            -HydrationLogRepository hydration_log_repo
            +search_foods(query) list[CentralFood]
            +search_exercises(query) list[CentralExercise]
            +save_logs(user_id, log_data) Log
            +scan_meal(user_id, image) MealLog
            +voice_meal(user_id, audio) MealLog
            +voice_workout(user_id, audio) WorkoutLog
            +voice_weight(user_id, audio) WeightLog
            +get_workout_logs(user_id) list[WorkoutLog]
            +get_meal_logs(user_id) list[MealLog]
            +get_weight_logs(user_id) list[WeightLog]
            +get_sleep_logs(user_id) list[SleepLog]
            +get_hydration_logs(user_id) list[HydrationLog]
            +create_manual_food(user_id, data) CentralFood
            +create_manual_exercise(user_id, data) CentralExercise
        }

        class MealScannerService {
            <<Service>>
            -LLMClient llm_client
            +analyze_food_image(image) dict
        }

        class VoiceTranscriberService {
            <<Service>>
            -LLMClient llm_client
            +transcribe_audio(audio_file) str
        }
    }

    %% ========== NOTIFICATION MODULE - SERVICES ==========

    namespace NotificationModule {
        class NotificationService {
            <<Service>>
            -DeviceTokenRepository device_token_repo
            -NotificationPreferenceRepository pref_repo
            +register_token(user_id, token, platform) DeviceToken
            +deregister_token(user_id, token) void
            +get_preferences(user_id) NotificationPreference
            +update_preferences(user_id, prefs) NotificationPreference
        }

        class PushService {
            <<Service>>
            -FCMClient fcm_client
            +send_push(device_token, title, body) bool
            +send_push_multi(tokens, title, body) list[bool]
        }

        class ReminderService {
            <<Service>>
            -PushService push_service
            -DeviceTokenRepository device_token_repo
            -NotificationPreferenceRepository pref_repo
            +check_hydration_reminders() void
            +check_meal_reminders() void
            +check_workout_reminders() void
            +check_sleep_reminders() void
            +trigger_hydration_instant(user_id) void
            +trigger_meal_instant(user_id) void
            +trigger_workout_instant(user_id) void
            +trigger_sleep_instant(user_id) void
        }
    }

    %% ========== RECOMMENDATION MODULE - SERVICES ==========

    namespace RecommendationModule {
        class CoachingService {
            <<Service>>
            -LLMClient llm_client
            -CoachingMessageRepository coaching_repo
            +run_daily_coaching() void
            +run_weekly_coaching() void
            +trigger_daily_for_user(user_id) CoachingMessage
            +trigger_weekly_for_user(user_id) CoachingMessage
        }

        class RecommendationService {
            <<Service>>
            -CoachingMessageRepository coaching_repo
            +get_daily_suggestion(user_id) dict
            +get_progress_report(user_id) dict
        }
    }

    %% ========== AI SERVICES MODULE ==========

    namespace AIServicesModule {
        class AICoachService {
            <<Service>>
            -LLMClient llm_client
            -VectorDBService vector_db
            +generate_workout_plan(profile, preferences) WorkoutPlanDTO
            +generate_nutrition_plan(profile, preferences) NutritionPlanDTO
            +ask_coach(user_query, profile) str
            -_build_workout_prompt(profile, preferences, rag_context) str
            -_build_nutrition_prompt(profile, preferences, rag_context) str
            -_build_ask_coach_prompt(user_query, profile, rag_context) str
            -_call_llm(prompt) str
            -_extract_json_from_response(response) dict
        }

        class LLMClient {
            <<Service>>
            -str api_key
            -str model
            -str base_url
            +call(prompt) str
            +call_with_json(prompt) dict
        }

        class VectorDBService {
            <<Service>>
            -str persist_directory
            -str collection_name
            -HuggingFaceEmbeddings embeddings
            -Chroma vectorstore
            +get_context(query, k) str
            +similarity_search(query, k) list[Document]
            +create_vector_db(force_recreate) None
            +load_documents() list[Document]
        }
    }

    %% ========== SHARED SERVICES ==========

    namespace SharedModule {
        class EmailService {
            <<Service>>
            -SMTPConfig smtp_config
            +send_email(to_email, subject, body) bool
            +send_html_email(to_email, subject, html) bool
        }

        class RedisClient {
            <<Service>>
            -Redis redis_instance
            +get_client() Redis
        }

        class CeleryApp {
            <<Scheduled Tasks>>
            +check_hydration_reminders ~every 60min~
            +check_meal_reminders ~every 30min~
            +check_workout_reminders ~every 60min~
            +check_sleep_reminders ~every 60min~
            +run_daily_coaching ~daily~
            +run_weekly_coaching ~weekly~
        }
    }

    %% ========== SERVICE DEPENDENCIES ==========

    %% Auth Module Dependencies
    AuthService --> VerificationService : uses
    AuthService --> AuthEmailService : uses
    VerificationService --> RedisClient : uses
    OTPService --> RedisClient : uses
    AuthEmailService --> EmailService : uses

    %% Profile Module Dependencies
    ProfileService ..> PlanGenerationService : provides_profile_to

    %% Planning Module Dependencies
    PlanGenerationService --> WorkoutPlanService : uses
    PlanGenerationService --> NutritionPlanService : uses
    PlanGenerationService --> AICoachService : uses
    PlanGenerationService --> ProfileService : uses
    AICoachService --> VectorDBService : uses
    AICoachService --> LLMClient : uses

    %% Tracking Module Dependencies
    TrackingService --> MealScannerService : uses
    TrackingService --> VoiceTranscriberService : uses
    MealScannerService --> LLMClient : uses
    VoiceTranscriberService --> LLMClient : uses

    %% Notification Module Dependencies
    NotificationService --> PushService : uses
    ReminderService --> PushService : uses
    ReminderService --> NotificationService : uses

    %% Recommendation Module Dependencies
    CoachingService --> LLMClient : uses
    CoachingService --> RecommendationService : uses

    %% Celery Scheduled Task Dependencies
    CeleryApp --> ReminderService : triggers
    CeleryApp --> CoachingService : triggers

    %% LLM Client connects to OpenRouter
    LLMClient ..> LLMClient : connects_to_OpenRouter
