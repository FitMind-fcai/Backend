          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WorkoutPlanGenerationRequest" },
              "example": {
                "duration_weeks": 8,
                "workout_preferences": {
                  "workout_days_per_week": 4,
                  "workout_location": "Gym",
                  "equipment_availability": "Full Gym Equipment",
                  "workout_focus": "Strength Training",
                  "workout_difficulty": "Intermediate",
                  "session_duration_minutes": 60,
                  "focus_areas": ["chest", "back", "shoulders", "legs"]
                }
              }
