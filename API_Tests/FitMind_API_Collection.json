    "/v1/plans/generate/workout": {
      "post": {
        "tags": ["Plan Generation"],
        "summary": "Generate Workout Plan",
        "description": "Generate or update an AI-powered workout plan based on your profile and preferences.\n\n**Smart update:** If a plan already exists, the AI keeps exercises that still match your requirements and only changes what conflicts with the new preferences.",
        "operationId": "plan_generate_workout",
        "security": [{ "BearerAuth": [] }],
