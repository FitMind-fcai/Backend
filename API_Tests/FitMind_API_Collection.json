        "responses": {
          "200": {
            "description": "Workout plan generated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WorkoutPlanResponse" }
              }
            }
          },
          "400": { "description": "Profile not found or incomplete" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
