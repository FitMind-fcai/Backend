# ========== Database Configuration ==========
# For Docker: use service name 'db'
# For local development: use 'localhost'
DATABASE_URL=postgresql+psycopg://postgres:postgres123@db:5432/fastapi_db

# ========== Redis Configuration ==========
# For Docker: use service name 'redis'
# For local development: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== JWT Configuration ==========
JWT_SECRET_KEY=dev-secret-key-change-in-production-12345
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ========== Email SMTP Configuration ==========
# Gmail example (use App Password, not regular password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=fitmind.dev.fcai@gmail.com
SENDER_PASSWORD=reiislglpgbmoafr
APP_URL=http://localhost:8000

# ========== AI Configuration ==========

# --- Groq (required for Whisper audio transcription) ---
GROQ_API_KEY=

EVAL_GROQ_API_KEY=
EVAL_GROQ_MODEL=llama-3.3-70b-versatile

# --- AI Coach (text LLM) ---
# AI_PROVIDER: openrouter | groq
AI_PROVIDER=openrouter
# AI_API_KEY is also used as the OpenRouter key for meal scanner + voice LLM parser.
AI_API_KEY=your_openrouter_key_here
AI_MODEL=qwen/qwen-2.5-72b-instruct
AI_COACH_TEMPERATURE=0.1
AI_COACH_MAX_TOKENS=6000
AI_RAG_TOP_K=3
AI_RAG_MAX_CONTEXT_CHARS=1200

# --- OpenRouter attribution headers (optional but recommended) ---
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=FitMind
# OPENROUTER_API_KEY is an alias for AI_API_KEY — set either one.
# OPENROUTER_API_KEY=your_openrouter_key_here

# --- Meal Scanner (Qwen2.5-VL vision model) ---
# QWEN_VL_PROVIDER: openrouter | together  (auto-selects base URL + model ID)
# Leave blank to use Together AI by default when TOGETHER_API_KEY is set.
QWEN_VL_PROVIDER=openrouter
# QWEN_VL_API_KEY overrides the provider key for the vision model only.
# QWEN_VL_API_KEY=
# QWEN_VL_API_BASE=https://openrouter.ai/api/v1   (override base URL)
# QWEN_VL_MODEL=qwen/qwen2.5-vl-72b-instruct      (override model)

# Together AI key — used when QWEN_VL_PROVIDER=together (or as fallback)
# TOGETHER_API_KEY=

# --- Voice LLM Parser ---
# Defaults to OpenRouter (AI_API_KEY) if set; falls back to Groq otherwise.
# LLM_PARSER_API_BASE=https://openrouter.ai/api/v1
# LLM_PARSER_MODEL=meta-llama/llama-3.3-70b-instruct

VECTOR_DB_PATH=chroma_db

# AI Model Configuration
AI_MODEL_NAME=mixtral-8x7b-32768
AI_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_VECTOR_COLLECTION_NAME=fitness_knowledge

# AI Generation Parameters
AI_TEMPERATURE_WORKOUT=0.3
AI_TEMPERATURE_NUTRITION=0.4
AI_TEMPERATURE_SUGGESTIONS=0.7
AI_MAX_TOKENS_PLANS=4000
AI_MAX_TOKENS_SUGGESTIONS=800
AI_RAG_TOP_K=3

# ========== Environment ==========
ENVIRONMENT=development